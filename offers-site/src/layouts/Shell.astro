---
import '../styles/refonte.css';
import {LANGS, t, href, type Lang} from '../i18n';
import {ui} from '../i18n/ui';
import {YOUTUBE, TELEGRAM} from '../data/casinos';
import {loadFeed, byKind} from '../data/wins';
// Proposition de refonte (piste A ou B, choisie au build par REFONTE) : en-tête horizontal, pas de barre latérale ni de bandeau défilant.
interface Props {lang: Lang; title: string; desc: string; path?: string; jsonld?: object[]; active?: string}
const {lang, title, desc, path = '', jsonld = [], active = ''} = Astro.props;
const d = t(lang);
const u = ui(lang);
const site = Astro.site!.origin;
const canonical = site + href(lang, path);
const theme = process.env.REFONTE === 'B' ? 'b' : 'a';
const hasWins = byKind(await loadFeed(), 'daily').length > 0;
const nav = [
  ...(hasWins ? [{k: 'wins', label: u.wins.nav, url: href(lang, 'wins/')}] : []),
  {k: 'offers', label: u.nav.offers, url: href(lang) + '#offers'},
  {k: 'guide', label: u.nav.guide, url: href(lang, 'guide/')},
  {k: 'telegram', label: 'Telegram', url: href(lang, 'telegram/')},
];
const ld = [
  {'@context': 'https://schema.org', '@type': 'Organization', '@id': site + '/#org', name: 'Big Win Daily', url: site + '/', logo: site + '/icon-512.png', sameAs: [YOUTUBE]},
  ...jsonld,
];
---
<!doctype html>
<html lang={d.locale} class={`rf rf-${theme}`}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href={canonical} />
  {LANGS.map(l => <link rel="alternate" hreflang={t(l).locale.slice(0, 2)} href={site + href(l, path)} />)}
  <link rel="alternate" hreflang="x-default" href={site + href('en', path)} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={theme === 'b' ? 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap' : 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap'} rel="stylesheet" />
  {ld.map(o => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
  <header class="hd">
    <div class="wrap hd-in">
      <a class="brand" href={href(lang)}><img src="/img/bwd-256.png" alt="" width="32" height="32" /><span>Big Win Daily</span></a>
      <nav class="hd-nav" aria-label="Menu">{nav.map(n => <a href={n.url} aria-current={active === n.k ? 'page' : undefined}>{n.label}</a>)}</nav>
      <details class="hd-lang">
        <summary aria-label={d.nav.language}>{d.short}</summary>
        <ul>{LANGS.map(l => <li><a href={href(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{t(l).name}</a></li>)}</ul>
      </details>
    </div>
  </header>

  <main id="main" class="wrap"><slot /></main>

  <footer class="ft">
    <div class="wrap ft-in">
      <div>
        <p class="ft-brand">Big Win Daily</p>
        <p>{d.footer.disclosure}</p>
        <p>{d.footer.age}</p>
      </div>
      <nav aria-label="Footer">
        <a href={href(lang, 'about/')}>{u.nav.about}</a>
        <a href={href(lang, 'responsible-gambling/')}>{u.nav.rg}</a>
        <a href={href(lang, 'privacy/')}>{d.footer.links.privacy}</a>
        <a href={YOUTUBE} target="_blank" rel="noopener">YouTube</a>
        <a href={TELEGRAM} target="_blank" rel="noopener" data-go="telegram" data-place="footer">Telegram</a>
      </nav>
    </div>
  </footer>

  <div class="gate" id="gate" hidden role="dialog" aria-modal="true" aria-labelledby="gate-t">
    <div class="gate-box">
      <h2 id="gate-t">{u.age.title}</h2>
      <p>{u.age.text}</p>
      <div class="gate-act">
        <button type="button" class="btn" data-gate-yes>{u.age.yes}</button>
        <a class="btn btn-2" href="https://www.google.com" rel="nofollow">{u.age.no}</a>
      </div>
    </div>
  </div>
  <script>import '../scripts/site.ts';</script>
</body>
</html>
