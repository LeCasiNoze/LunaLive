---
import '../styles/global.css';
import {LANGS, t, href, type Lang} from '../i18n';
import {ui} from '../i18n/ui';
import {YOUTUBE, TELEGRAM} from '../data/casinos';
import {loadFeed, byKind} from '../data/wins';
import {SL} from '../data/slots';

// mono : page en une seule langue (pas d'alternates hreflang).
interface Props {lang: Lang; title: string; desc: string; path?: string; jsonld?: object[]; noindex?: boolean; sticky?: boolean; active?: string; mono?: boolean; image?: string}
const {lang, title, desc, path = '', jsonld = [], noindex = false, sticky = true, active = '', mono = false, image} = Astro.props;
const d = t(lang);
const u = ui(lang);
const site = Astro.site!.origin;
const canonical = site + href(lang, path);
const ld = [
  {'@context': 'https://schema.org', '@type': 'Organization', '@id': site + '/#org', name: 'Big Win Daily', url: site + '/', logo: site + '/icon-512.png', sameAs: [YOUTUBE]},
  {'@context': 'https://schema.org', '@type': 'WebSite', '@id': site + '/#site', name: 'Big Win Daily', url: site + '/', inLanguage: LANGS.map(l => t(l).locale), publisher: {'@id': site + '/#org'}},
  ...jsonld,
];
// Une page d'avis casino allume l'entrée « Casino bonuses ».
const cur = ['rainbet', 'celsius', 'betportal'].includes(active) ? 'offers' : path.startsWith('slots') ? 'slots' : active;
const hasWins = byKind(await loadFeed(), 'daily').length > 0;
// Menu court, comme les sites du secteur : les avis casino sont dans « Casino bonuses ».
const nav = [
  ...(hasWins ? [{k: 'wins', label: u.wins.nav, url: href(lang, 'wins/')}] : []),
  {k: 'slots', label: SL[lang].crumb, url: href(lang, 'slots/')},
  {k: 'offers', label: u.nav.offers, url: href(lang) + '#offers'},
  {k: 'guide', label: u.nav.guide, url: href(lang, 'guide/')},
];
const foot = [
  {label: u.nav.about, url: href(lang, 'about/')},
  {label: u.nav.rg, url: href(lang, 'responsible-gambling/')},
  {label: u.tg.nav, url: href(lang, 'telegram/')},
];
---
<!doctype html>
<html lang={d.locale} class="rf rf-a">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
  <link rel="canonical" href={canonical} />
  {!noindex && !mono && LANGS.map(l => <link rel="alternate" hreflang={t(l).locale.slice(0, 2)} href={site + href(l, path)} />)}
  {!noindex && !mono && <link rel="alternate" hreflang="x-default" href={site + href('en', path)} />}
  <meta name="google-site-verification" content="Pm6sWjjh1lu2tu7G8St63-k13pzdxC77wWsTOUBBfz4" />
  <meta name="google-site-verification" content="x4oEe0c4uEHjIztc11OKQXFP-Piu1Ss1ZJpIDPc_uZQ" />
  <meta name="theme-color" content="#0f1115" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/icon-512.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Big Win Daily" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  {/* image : vignette de la vidéo du jour sur /wins/, sinon l'image du site (1200 × 630). */}
  <meta property="og:image" content={image ?? site + '/og.png'} />
  {!image && <meta property="og:image:width" content="1200" />}
  {!image && <meta property="og:image:height" content="630" />}
  <meta property="og:locale" content={d.locale.replace('-', '_')} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://lunalive-api.onrender.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  {ld.map(o => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
  <header class="hd">
    <div class="wrap hd-in">
      <a class="brand" href={href(lang)} aria-label="Big Win Daily"><img src="/img/bwd-256.png" alt="" width="32" height="32" /><span>Big Win Daily</span></a>
      <nav class="hd-nav" aria-label="Menu">{nav.map(n => <a href={n.url} aria-current={cur === n.k ? 'page' : undefined}>{n.label}</a>)}</nav>
      <a class="hd-tg" href={TELEGRAM} target="_blank" rel="noopener" data-go="telegram" data-place="topbar">Telegram</a>
      <details class="lang">
        <summary><span class="vh">{d.nav.language} </span>{d.short}</summary>
        <ul>{LANGS.map(l => <li><a href={href(l, mono ? '' : path)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{t(l).name}</a></li>)}</ul>
      </details>
    </div>
  </header>

  <main id="main" class="wrap"><slot /></main>

  <footer class="ft">
    <div class="wrap ft-in">
      <div>
        <p class="ft-brand">Big Win Daily</p>
        <p>{d.footer.disclosure}</p>
        <p>{d.footer.age}</p>
        <p>{d.footer.rights}</p>
      </div>
      <nav aria-label="Footer">
        {foot.map(n => <a href={n.url}>{n.label}</a>)}
        <a href={href(lang, 'privacy/')}>{d.footer.links.privacy}</a>
        <a href={YOUTUBE} rel="noopener" target="_blank">YouTube</a>
      </nav>
      <nav class="ft-langs" aria-label={d.nav.language}>{LANGS.map(l => <a href={href(l, mono ? '' : path)} hreflang={l} aria-current={l === lang ? 'true' : undefined}>{t(l).name}</a>)}</nav>
    </div>
  </footer>

  <div class="gate" id="gate" hidden role="dialog" aria-modal="true" aria-labelledby="gate-t">
    <div class="gate-box">
      <h2 id="gate-t">{u.age.title}</h2>
      <p>{u.age.text}</p>
      <div class="gate-act">
        <button type="button" class="btn btn-play" data-gate-yes>{u.age.yes}</button>
        <a class="btn btn-ghost" href="https://www.google.com" rel="nofollow">{u.age.no}</a>
      </div>
    </div>
  </div>
  <script>import '../scripts/site.ts';</script>
</body>
</html>
