---
import {CASINOS, byId} from '../../data/casinos';
// Liens courts pour les descriptions YouTube/Instagram : /go/rainbet/?src=yt → clic compté puis redirection.
export function getStaticPaths() { return CASINOS.map(c => ({params: {id: c.id}})); }
const c = byId(Astro.params.id!);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta http-equiv="refresh" content={`3;url=${c.affiliate}`} />
  <title>{c.name} – Big Win Daily</title>
  <style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#06070c;color:#f3f4fa;font:16px/1.5 system-ui,sans-serif;text-align:center}img{width:72px;height:72px;border-radius:18px;margin:0 auto 16px}a{color:#ffcf4a}</style>
</head>
<body data-go-redirect>
  <div><img src={c.logo} alt="" /><p>Opening {c.name}…</p><p><a href={c.affiliate} rel="sponsored noopener">Continue</a></p></div>
  <script is:inline define:vars={{url: c.affiliate, id: c.id}}>
    (function () {
      var q = new URLSearchParams(location.search);
      // L'API refuse tout l'événement (400) si un champ dépasse 160 caractères.
      var camp = q.get('c') || q.get('utm_campaign');
      var src = (q.get('utm_source') || q.get('src') || 'golink').slice(0, 160);
      var dest = url.replace(/([?&]afp=)[^&]*/, function (m, p) { return p + encodeURIComponent(src.slice(0, 40)); });
      var body = JSON.stringify({slug: 'bigwindaily', event: 'click_cta', referrer: document.referrer || null, utmSource: src, utmMedium: q.get('utm_medium') && q.get('utm_medium').slice(0, 160), utmCampaign: ('go|' + id + (camp ? '|' + camp : '')).slice(0, 160)});
      var done = false; var go = function () { if (!done) { done = true; location.replace(dest); } };
      try { fetch('https://lunalive-api.onrender.com/api/public/affi-events', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: body, keepalive: true}).finally(go); } catch (e) { go(); }
      setTimeout(go, 600);
    })();
  </script>
</body>
</html>
