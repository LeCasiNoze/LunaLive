---
import Home from '../components/Home.astro';
import Review from '../components/Review.astro';
import Prose, {type Kind} from '../components/Prose.astro';
import {LANGS, type Lang} from '../i18n';
import {CASINOS, byId} from '../data/casinos';

// Toutes les pages, pour toutes les langues : anglais à la racine, autres langues sous /<lang>/.
export function getStaticPaths() {
  const pages: {kind: string; sub: string}[] = [
    {kind: 'home', sub: ''},
    ...CASINOS.map(c => ({kind: 'review', sub: `casinos/${c.id}`})),
    ...['guide', 'about', 'responsible-gambling', 'privacy'].map(k => ({kind: k, sub: k})),
  ];
  return LANGS.flatMap(lang => pages.map(p => ({
    params: {slug: [lang === 'en' ? '' : lang, p.sub].filter(Boolean).join('/') || undefined},
    props: {lang, kind: p.kind, sub: p.sub},
  })));
}
const {lang, kind, sub} = Astro.props as {lang: Lang; kind: string; sub: string};
---
{kind === 'home' ? <Home lang={lang} /> : kind === 'review' ? <Review lang={lang} c={byId(sub.split('/')[1])} /> : <Prose lang={lang} kind={kind as Kind} />}
