---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import GroupCards from './GroupCards.astro';
import {t, href, fmt, type Lang} from '../i18n';
import {ui} from '../i18n/ui';
import {ranked, TELEGRAM} from '../data/casinos';
import {type WinsPage, top, money, multi, streamerName, platformName, channelUrl, dayLabel, weekLabel, isoWeek, slug} from '../data/wins';
// Pages « Biggest slot wins » : dernier Top, un jour, archive d'une semaine. Construites depuis le flux du VPS.
interface Props {lang: Lang; page: WinsPage}
const {lang, page} = Astro.props;
const d = t(lang);
const u = ui(lang);
const w = u.wins;
const site = Astro.site!.origin;
const {kind, v} = page;
const clips = v ? top(v) : [];
const n1 = clips[0];
const date = v && v.kind === 'daily' ? dayLabel(lang, v.period) : '';
const wk = kind === 'week' ? weekLabel(lang, page.week!) : '';
const pfs = (cs: typeof clips) => [...new Set(cs.map(c => platformName(c.platform)))].join(' & ');
// Nom du jeu accolé au multiplicateur quand le flux le donne (« x10,781 on Bootleggers »).
const xg = (c: typeof clips[number]) => (c.game ? `${multi(c.multi)} ${w.on} ${c.game}` : multi(c.multi));
const vars = n1 ? {n: clips.length, date, x: multi(n1.multi), who: streamerName(n1.streamer), pf: platformName(n1.platform), w: wk} : {w: wk};
let title = kind === 'latest' ? fmt(w.tLatest, vars) : kind === 'day' ? fmt(w.tDay, vars) : fmt(w.tWeek, vars);
// Limites d'affichage Google : on retire d'abord le complément « – x par streamer », puis la date entre parenthèses.
if (title.length > 60) title = title.split(' – ')[0];
if (title.length > 60) title = title.replace(/ \([^)]*\)$/, '');
// Les modèles séparent par « ¦ » les segments facultatifs, retirés de la fin tant que la description dépasse 160 caractères.
const segs = fmt(kind === 'week' ? w.dWeek : w.dDay, vars).split('¦');
while (segs.length > 1 && segs.join('').length > 160) segs.pop();
const desc = segs.join('');
const h1 = kind === 'latest' ? fmt(w.h1Latest, vars) : kind === 'day' ? fmt(w.h1Day, vars) : fmt(w.h1Week, vars);
// « Le plus gros » = plus haut multiplicateur, pas forcément le n° 1 : les vidéos d'avant le 21/11 étaient classées sur le prix payé.
const big = clips.reduce((a, c) => (c.multi > a.multi ? c : a), n1);
const stake = !big ? '' : big.bonus_buy ? (big.buy_cost != null ? fmt(w.stakeBuy, {v: money(big.buy_cost, big.currency, lang)}) : w.stakeBuyNoPrice) : big.bet != null ? fmt(w.stakeBet, {v: money(big.bet, big.currency, lang)}) : '';
const intro = n1 ? [fmt(w.intro1, {...vars, x: xg(big), who: streamerName(big.streamer), pf: platformName(big.platform), stake}), fmt(w.intro2, {s: new Set(clips.map(c => c.streamer.toLowerCase())).size, pfs: pfs(clips), n: clips.length, xl: multi(clips[clips.length - 1].multi)}), w.method].join(' ') : '';
// Nom du jeu lié à sa page quand elle existe (2 gains vérifiés ou plus).
const slotUrl = (g: string) => page.slots?.find(x => x.sub === `wins/slot/${slug(g)}/`) && href(lang, `wins/slot/${slug(g)}/`);
const yt = v?.youtube_id ? `https://www.youtube.com/watch?v=${v.youtube_id}` : null;
const thumb = v?.thumb || (v?.youtube_id ? `https://i.ytimg.com/vi/${v.youtube_id}/hqdefault.jpg` : null);
// Une vidéo limitée par l'âge ne s'intègre pas : vignette cliquable, et pas de VideoObject (la page n'est pas une page de lecture).
const embed = !!v?.youtube_id && v.age_restricted === false;
const crumbs = [
  {name: d.review.crumbsHome, url: href(lang)},
  {name: w.crumb, url: href(lang, 'wins/')},
  ...(kind === 'latest' ? [] : [{name: kind === 'week' ? wk : date, url: href(lang, page.sub)}]),
];
const jsonld = [
  {'@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({'@type': 'ListItem', position: i + 1, name: c.name, item: site + c.url}))},
  ...(clips.length ? [{'@context': 'https://schema.org', '@type': 'ItemList', name: h1, itemListOrder: 'https://schema.org/ItemListOrderDescending', numberOfItems: clips.length,
    itemListElement: clips.map(c => ({'@type': 'ListItem', position: c.rank, name: `${xg(c)} – ${streamerName(c.streamer)} (${platformName(c.platform)})`}))}] : []),
  ...(embed && v!.publish_at ? [{'@context': 'https://schema.org', '@type': 'VideoObject', name: v!.title || title, description: desc, thumbnailUrl: thumb, uploadDate: v!.publish_at, contentUrl: yt, embedUrl: `https://www.youtube-nocookie.com/embed/${v!.youtube_id}`}] : []),
];
const dayCards = page.days.map(x => ({url: href(lang, `wins/${x.period}/`), label: dayLabel(lang, x.period), sub: `#1 ${streamerName(top(x)[0].streamer)} · ${multi(top(x)[0].multi)}`}));
---
<Base lang={lang} title={title} desc={desc} path={page.sub} jsonld={jsonld} active="wins">
  <div class="page">
    <ol class="crumbs">{crumbs.map((c, i) => i < crumbs.length - 1 ? <li><a href={c.url}>{c.name}</a></li> : <li aria-current="page">{c.name}</li>)}</ol>

    <header class="phero">
      <span class="kick"><Icon name="trophy" />{kind === 'week' ? wk : `Top ${clips.length} · ${date}`}</span>
      <h1>{h1}</h1>
      {intro && <p>{intro}</p>}
    </header>

    {v && yt && (
      embed
        ? <div class="wins-video"><iframe src={`https://www.youtube-nocookie.com/embed/${v.youtube_id}`} title={title} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
        : <a class="wins-video" href={yt} target="_blank" rel="noopener" data-go="youtube" data-place="wins-page">{thumb && <img src={thumb} alt={title} width="480" height="360" loading="lazy" />}<span class="btn btn-yt"><Icon name="yt" />{fmt(w.watch, {n: clips.length})}</span></a>
    )}

    {clips.length > 0 && (
      <>
        <h2 class="sec-title">{kind === 'week' ? w.weekVideo : w.ranking}</h2>
        <div class="vs-table wins-table">
          <table>
            <thead><tr>{w.cols.map(c => <th scope="col">{c}</th>)}</tr></thead>
            <tbody>{clips.map(c => <tr><th scope="row">{c.rank}</th><td><a href={channelUrl(c)} target="_blank" rel="noopener nofollow">{streamerName(c.streamer)}</a><br /><small><time datetime={c.at}>{new Intl.DateTimeFormat(t(lang).locale, {day: 'numeric', month: 'short', timeZone: 'UTC'}).format(new Date(c.at.slice(0, 10) + 'T12:00:00Z'))}</time></small></td><td>{c.game ? <>{slotUrl(c.game) ? <a href={slotUrl(c.game)}>{c.game}</a> : c.game}{c.provider && <small>{c.provider}</small>}</> : '–'}</td><td>{platformName(c.platform)}</td><td><b class="x">{multi(c.multi)}</b></td><td>{money(c.bet, c.currency, lang)}{c.bonus_buy && <><br /><span class="buy">{w.buy.toLocaleUpperCase(t(lang).locale)}{c.buy_cost != null && ` ${money(c.buy_cost, c.currency, lang)}`}</span></>}</td><td>{money(c.win, c.currency, lang)}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="fine">{w.fine} <a href="/wins/feed.json" type="application/json">JSON</a></p>
      </>
    )}

    {kind === 'week' && <p class="fine">{w.method}</p>}

    <GroupCards lang={lang} title={w.bySlot} groups={page.slots} />
    <GroupCards lang={lang} title={w.byStreamer} groups={page.streamers} />

    <a class="wins wins-tg" href={TELEGRAM} target="_blank" rel="noopener" data-go="telegram" data-place="wins-page" style="margin-top:28px">
      <div><h2>{u.tg.title}</h2><p>{u.tg.sub}</p></div>
      <span class="btn btn-yt btn-tg btn-lg"><Icon name="tg" />{u.tg.short}</span>
    </a>

    {dayCards.length > 0 && (
      <>
        <h2 class="sec-title">{kind === 'week' ? w.days : w.more}</h2>
        <div class="others">{dayCards.map(c => <a class="mini" href={c.url}><div><b>{c.label}</b><span>{c.sub}</span></div><Icon name="arrow" /></a>)}</div>
      </>
    )}

    {(page.prev || page.next || page.weekSub) && (
      <div class="others" style="margin-top:16px">
        {page.prev && <a class="mini" href={href(lang, page.prev)}><div><b>← {kind === 'week' ? w.prevW : w.prev}</b></div></a>}
        {page.weekSub && <a class="mini" href={href(lang, page.weekSub)}><div><b>{w.weekLink}</b><span>{weekLabel(lang, isoWeek(v!.period))}</span></div><Icon name="arrow" /></a>}
        {page.next && <a class="mini" href={href(lang, page.next)}><div><b>{kind === 'week' ? w.nextW : w.next} →</b></div></a>}
      </div>
    )}

    <h2 class="sec-title">{u.offersTitle}</h2>
    <div class="others">{ranked(lang).map(o => <a class={`mini m-${o.id}`} href={href(lang, `casinos/${o.id}/`)}><img src={o.logo} alt="" width="46" height="46" loading="lazy" /><div><b>{o.name}</b><span>{d.casino[o.id].headline}</span></div><Icon name="arrow" /></a>)}</div>

    <div class="rg" style="margin-top:40px">
      <span class="ic">18+</span>
      <div><h3>{w.rgT}</h3><p>{w.rgP}</p></div>
      <a href={href(lang, 'responsible-gambling/')}>{d.rg.link} →</a>
    </div>
  </div>
</Base>
