---
// Pièce d'or 3D décorative (SVG pur, aucun appel réseau).
interface Props {size?: number; class?: string; style?: string; tilt?: number}
const {size = 90, class: cls = '', style = '', tilt = -14} = Astro.props;
const id = 'cn' + Math.random().toString(36).slice(2, 7);
---
<svg class={`coin ${cls}`} style={style} viewBox="0 0 120 120" width={size} height={size} aria-hidden="true">
  <defs>
    <radialGradient id={`${id}f`} cx="34%" cy="28%" r="80%"><stop offset="0" stop-color="#fff6c4"/><stop offset=".35" stop-color="#ffd23f"/><stop offset=".8" stop-color="#e59a00"/><stop offset="1" stop-color="#b86f00"/></radialGradient>
    <linearGradient id={`${id}e`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8a5200"/><stop offset=".5" stop-color="#d48a00"/><stop offset="1" stop-color="#7a4600"/></linearGradient>
  </defs>
  <g transform={`rotate(${tilt} 60 60)`}>
    <ellipse cx="60" cy="68" rx="48" ry="46" fill={`url(#${id}e)`}/>
    <ellipse cx="60" cy="58" rx="48" ry="46" fill={`url(#${id}f)`}/>
    <ellipse cx="60" cy="58" rx="37" ry="35" fill="none" stroke="#c98200" stroke-width="3"/>
    <path d="M60 30l8.2 16.6 18.3 2.7-13.2 12.9 3.1 18.2L60 71.8l-16.4 8.6 3.1-18.2-13.2-12.9 18.3-2.7z" fill="#b06a00" transform="translate(1.5 2.5)"/>
    <path d="M60 30l8.2 16.6 18.3 2.7-13.2 12.9 3.1 18.2L60 71.8l-16.4 8.6 3.1-18.2-13.2-12.9 18.3-2.7z" fill="#fff3b0"/>
    <ellipse cx="40" cy="34" rx="14" ry="6" fill="#fff" opacity=".45" transform="rotate(-30 40 34)"/>
  </g>
</svg>
