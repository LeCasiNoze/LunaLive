---
import Base from '../layouts/Base.astro';
import {t, href, fmt, type Lang} from '../i18n';
import {ui} from '../i18n/ui';
import {ranked, TELEGRAM} from '../data/casinos';
import {bySlotName} from '../data/slots';
import {maxWinPages} from '../data/maxwin';
import {type WinsPage, top, money, multi, streamerName, platformName, channelUrl, dayLabel, monthLabel, slug, clipVideo, mmss} from '../data/wins';
// Proposition de refonte de /wins/ (dernier Top et pages jour) : le classement d'abord, la vidéo et l'offre principale à côté.
interface Props {lang: Lang; page: WinsPage}
const {lang, page} = Astro.props;
const d = t(lang);
const u = ui(lang);
const w = u.wins;
const site = Astro.site!.origin;
const v = page.v!;
const clips = top(v);
const n1 = clips[0];
const date = dayLabel(lang, v.period);
const dayShort = new Intl.DateTimeFormat(d.locale, {day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC'}).format(new Date(v.period + 'T12:00:00Z'));
const vars = {n: clips.length, date, x: multi(n1.multi), who: streamerName(n1.streamer), pf: platformName(n1.platform)};
let title = page.kind === 'latest' ? fmt(w.tLatest, vars) : fmt(w.tDay, vars);
// Au-delà de 60 caractères : d'abord le mois abrégé (on garde « x4,940 by … », le plus cherché), sinon on coupe le complément.
if (title.length > 60) title = (page.kind === 'latest' ? fmt(w.tLatest, {...vars, date: dayShort}) : fmt(w.tDay, {...vars, date: dayShort}));
if (title.length > 60) title = title.split(' – ')[0];
const segs = fmt(w.dDay, vars).split('¦');
while (segs.length > 1 && segs.join('').length > 160) segs.pop();
const desc = segs.join('');
const h1 = page.kind === 'latest' ? fmt(w.h1Latest, vars) : fmt(w.h1Day, vars);
const big = clips.reduce((a, c) => (c.multi > a.multi ? c : a), n1);
const xg = (c: typeof n1) => (c.game ? `${multi(c.multi)} ${w.on} ${c.game}` : multi(c.multi));
const stake = big.bonus_buy ? (big.buy_cost != null ? fmt(w.stakeBuy, {v: money(big.buy_cost, big.currency, lang)}) : w.stakeBuyNoPrice) : big.bet != null ? fmt(w.stakeBet, {v: money(big.bet, big.currency, lang)}) : '';
const pfs = [...new Set(clips.map(c => platformName(c.platform)))].join(' & ');
const lede = [fmt(w.intro1, {...vars, x: xg(big), who: streamerName(big.streamer), pf: platformName(big.platform), stake}), fmt(w.intro2, {s: new Set(clips.map(c => c.streamer.toLowerCase())).size, pfs, n: clips.length, xl: multi(clips[clips.length - 1].multi)})].join(' ');
const yt = v.youtube_id ? `https://www.youtube.com/watch?v=${v.youtube_id}` : null;
const thumb = v.thumb || (v.youtube_id ? `https://i.ytimg.com/vi/${v.youtube_id}/hqdefault.jpg` : null);
const embed = !!v.youtube_id && v.age_restricted === false;
const offer = ranked(lang)[0];
// Casino du clip (champ casino du flux) : lien vers notre avis seulement si c'est l'un de nos casinos.
const ours = (name: string) => ranked(lang).find(o => o.name.toLowerCase() === name.toLowerCase())?.id;
const streamerUrl = (c: typeof n1) => page.streamers?.find(x => x.sub === `wins/streamer/${slug(streamerName(c.streamer))}/`) && href(lang, `wins/streamer/${slug(streamerName(c.streamer))}/`);
// Fiche du catalogue d'abord (chiffres officiels), sinon la page des gains de ce jeu si elle existe.
const slotUrl = (g: string) => bySlotName(g) ? href(lang, `slots/${bySlotName(g)!.id}/`) : page.slots?.find(x => x.sub === `wins/slot/${slug(g)}/`) && href(lang, `wins/slot/${slug(g)}/`);
const crumbs = [{name: d.review.crumbsHome, url: href(lang)}, {name: w.crumb, url: href(lang, 'wins/')}, ...(page.kind === 'latest' ? [] : [{name: date, url: href(lang, page.sub)}])];
const jsonld = [
  {'@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({'@type': 'ListItem', position: i + 1, name: c.name, item: site + c.url}))},
  {'@context': 'https://schema.org', '@type': 'ItemList', name: h1, itemListOrder: 'https://schema.org/ItemListOrderDescending', numberOfItems: clips.length,
    itemListElement: clips.map(c => ({'@type': 'ListItem', position: c.rank, name: `${xg(c)} – ${streamerName(c.streamer)} (${platformName(c.platform)})`, ...(streamerUrl(c) ? {url: site + streamerUrl(c)} : {})}))},
  ...(page.kind === 'latest' ? [{'@context': 'https://schema.org', '@type': 'Dataset', name: 'Big Win Daily – verified slot wins from casino livestreams',
    description: 'Daily ranking of the biggest slot wins detected on public Kick and Rumble casino livestreams and checked frame by frame: streamer, platform, game, multiplier (win / base bet), bet, win and date. Amounts have no currency.',
    url: site + href('en', 'wins/'), creator: {'@id': site + '/#org'}, isAccessibleForFree: true, dateModified: v.period,
    keywords: ['slot wins', 'big win', 'casino streamers', 'Kick', 'Rumble', 'multiplier'],
    distribution: [{'@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: site + '/wins/feed.json'}]}] : []),
];
const cols = [w.cols[0], w.cols[1], w.cols[2], w.cols[4], w.cols[5], w.cols[6]];
---
<Base lang={lang} title={title} desc={desc} path={page.sub} jsonld={jsonld} active="wins" image={thumb && thumb.startsWith('http') ? thumb : undefined}>
  <ol class="crumbs">{crumbs.map((c, i) => i < crumbs.length - 1 ? <li><a href={c.url}>{c.name}</a></li> : <li aria-current="page">{c.name}</li>)}</ol>

  <header class="pg-hd">
    <p class="kick">Top {clips.length} · <time datetime={v.period}>{date}</time></p>
    <h1>{h1}</h1>
    <p class="lede">{lede}</p>
  </header>

  <div class="board">
    <section class="board-main" aria-labelledby="rk-t">
      <h2 id="rk-t" class="vh">{w.ranking}</h2>
      <div class="podium" aria-hidden="true">{clips.slice(0, 3).map(c => <div><i>#{c.rank}</i><strong>{multi(c.multi)}</strong><b>{streamerName(c.streamer)}</b><span>{c.game ?? platformName(c.platform)}</span></div>)}</div>
      <table class="rk rk-cards" role="table">
        <thead role="rowgroup"><tr role="row">{cols.map((c, i) => <th role="columnheader" scope="col" class={i >= 3 ? 'num' : undefined}>{c}</th>)}</tr></thead>
        <tbody role="rowgroup">{clips.map(c => (
          <tr role="row" class={c.rank === 1 ? 'top' : undefined}>
            <td role="cell" class="pos">{c.rank}</td>
            <td role="cell">{streamerUrl(c) ? <a href={streamerUrl(c)}>{streamerName(c.streamer)}</a> : streamerName(c.streamer)}<span class="sub"><a href={channelUrl(c)} target="_blank" rel="noopener nofollow">{platformName(c.platform)} ↗</a></span></td>
            <td role="cell">{c.game ? (slotUrl(c.game) ? <a href={slotUrl(c.game)}>{c.game}</a> : c.game) : <span class="na">–</span>}{(c.provider || c.casino) && <span class="sub">{[c.provider, c.casino && (ours(c.casino) ? null : `${w.on} ${c.casino}`)].filter(Boolean).join(' · ')}{c.casino && ours(c.casino) && <>{c.provider ? ' · ' : ''}<a href={href(lang, `casinos/${ours(c.casino)}/`)}>{w.on} {c.casino}</a></>}</span>}</td>
            <td role="cell" class="num x">{multi(c.multi)}{v.youtube_id && c.t != null && <span class="sub"><a href={clipVideo(v.youtube_id, c.t)!} target="_blank" rel="noopener" data-go="youtube" data-place="wins-clip">▶ {mmss(c.t)}</a></span>}</td>
            <td role="cell" data-l={cols[4]} class="num">{money(c.bet, c.currency, lang)}{c.bonus_buy && <span class="sub buy">{w.buy}</span>}</td>
            <td role="cell" data-l={cols[5]} class="num">{money(c.win, c.currency, lang)}</td>
          </tr>
        ))}</tbody>
      </table>
      <p class="note">{w.method} {w.fine} <a href="/wins/feed.json" type="application/json">JSON</a></p>
      {page.recordsSub && <p class="note"><a href={href(lang, page.recordsSub)}>{w.recordsLink} →</a></p>}
      {page.monthSub && <p class="note"><a href={href(lang, page.monthSub)}>{w.monthLink} · {monthLabel(lang, v.period.slice(0, 7))} →</a></p>}
    </section>

    <aside class="board-side">
      <div class="offer">
        <div class="offer-hd">
          <img src={offer.logo} alt="" width="40" height="40" />
          <div><b>{offer.name}</b><span>{d.casino[offer.id].headline}</span></div>
        </div>
        <a class="btn" href={offer.affiliate} target="_blank" rel="sponsored noopener" data-go={offer.id} data-place="wins-side">{u.play}</a>
        <p class="small">18+ · <a href={href(lang, `casinos/${offer.id}/`)}>{u.review}</a></p>
      </div>
      {yt && (embed
        ? <div class="vid"><iframe src={`https://www.youtube-nocookie.com/embed/${v.youtube_id}`} title={title} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
        : <a class="vid" href={yt} target="_blank" rel="noopener" data-go="youtube" data-place="wins-side">{thumb && <img src={thumb} alt={title} width="480" height="270" loading="lazy" />}<span>{fmt(w.watch, {n: clips.length})}</span></a>)}
      <a class="tg" href={TELEGRAM} target="_blank" rel="noopener" data-go="telegram" data-place="wins-side"><b>{u.tg.title}</b><span>{u.tg.short} →</span></a>
    </aside>
  </div>

  {page.days.length > 0 && (
    <section class="sec">
      <h2>{w.more}</h2>
      <table class="list"><tbody>{page.days.map(x => { const t1 = top(x)[0]; return <tr><td><a href={href(lang, `wins/${x.period}/`)}>{dayLabel(lang, x.period)}</a></td><td>{streamerName(t1.streamer)}</td><td class="num x">{multi(t1.multi)}</td></tr>; })}</tbody></table>
    </section>
  )}

  {((page.streamers?.length ?? 0) > 0 || (page.slots?.length ?? 0) > 0) && (
    <section class="sec cols2">
      {(page.streamers?.length ?? 0) > 0 && <div><h2>{w.byStreamer}</h2><ul class="links">{page.streamers!.map(g => <li><a href={href(lang, g.sub)}>{g.name}</a><span>{multi(g.hits[0].multi)}</span></li>)}</ul></div>}
      {lang === 'en' && maxWinPages().length > 0 && <div><h2>Max win: has anyone hit it?</h2><ul class="links">{maxWinPages().map(p => <li><a href={`/max-win/${p.id}/`}>{p.sheet.game} max win</a><span>{p.stats.wins} verified wins</span></li>)}</ul></div>}
      {(page.slots?.length ?? 0) > 0 && <div><h2>{w.bySlot}</h2><ul class="links">{page.slots!.map(g => <li><a href={href(lang, g.sub)}>{g.name}</a><span>{multi(g.hits[0].multi)}</span></li>)}</ul></div>}
    </section>
  )}

  <section class="sec rg">
    <h2>{w.rgT}</h2>
    <p>{w.rgP} <a href={href(lang, 'responsible-gambling/')}>{d.rg.link}</a></p>
  </section>
</Base>
