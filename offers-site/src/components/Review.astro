---
import Base from '../layouts/Base.astro';
import {intentsOf, intentPath} from '../data/intents';
import Icon from './Icon.astro';
import {t, href, fmt, fmtDate, type Lang} from '../i18n';
import {ui} from '../i18n/ui';
import {CASINOS, CHECKED, PAIRS, NOINDEX, type Casino} from '../data/casinos';
import {SLOTS, SL} from '../data/slots';
interface Props {lang: Lang; c: Casino}
const {lang, c} = Astro.props;
const d = t(lang);
const u = ui(lang);
const x = d.casino[c.id];
const r = d.review;
const date = fmtDate(lang, CHECKED);
const site = Astro.site!.origin;
const path = `casinos/${c.id}/`;
const ICON: Record<string, string> = {rakeback: 'percent', claim: 'clock', race: 'trophy', fs: 'star', maxbet: 'zap', days: 'repeat', deposits: 'layers', total: 'coins'};
const TONES = ['y', 'b', 'g', 'r', 'p', 'o'];
const faq = [...x.faq, d.faq.items[3]];
const pairs = PAIRS.filter(([a, b]) => a === c.id || b === c.id);
const jsonld = [
  {'@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    {'@type': 'ListItem', position: 1, name: r.crumbsHome, item: site + href(lang)},
    {'@type': 'ListItem', position: 2, name: r.crumbsReviews, item: site + href(lang) + '#offers'},
    {'@type': 'ListItem', position: 3, name: c.name, item: site + href(lang, path)},
  ]},
  {'@context': 'https://schema.org', '@type': 'Article', headline: x.h1, description: x.seoDesc, inLanguage: d.locale, datePublished: '2026-11-19', dateModified: CHECKED, author: {'@id': site + '/#org'}, publisher: {'@id': site + '/#org'}, mainEntityOfPage: site + href(lang, path), image: site + c.logo, about: {'@type': 'Organization', name: c.name}},
  {'@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: d.locale, mainEntity: faq.map(f => ({'@type': 'Question', name: f.q, acceptedAnswer: {'@type': 'Answer', text: f.a}}))},
];
// Libellés du bloc « en bref » (faits lus sur les conditions officielles du casino).
const FL: Record<string, {h: string; operator: string; licence: string; age: string; src: string; games: string}> = {
  en: {h: '{name} Casino at a glance', operator: 'Operator', licence: 'Licence', age: 'Minimum age', src: 'Source: the casino’s official terms of service, read on {date}.', games: 'Slots from our catalogue in the {name} game library'},
  fr: {h: '{name} Casino en bref', operator: 'Exploitant', licence: 'Licence', age: 'Âge minimum', src: 'Source : conditions générales officielles du casino, lues le {date}.', games: 'Machines à sous de notre catalogue présentes chez {name}'},
  de: {h: '{name} Casino im Überblick', operator: 'Betreiber', licence: 'Lizenz', age: 'Mindestalter', src: 'Quelle: offizielle AGB des Casinos, gelesen am {date}.', games: 'Slots aus unserem Katalog bei {name}'},
  es: {h: '{name} Casino en resumen', operator: 'Operador', licence: 'Licencia', age: 'Edad mínima', src: 'Fuente: condiciones oficiales del casino, leídas el {date}.', games: 'Tragaperras de nuestro catálogo en {name}'},
  pt: {h: '{name} Cassino em resumo', operator: 'Operador', licence: 'Licença', age: 'Idade mínima', src: 'Fonte: termos oficiais do cassino, lidos em {date}.', games: 'Slots do nosso catálogo na {name}'},
  it: {h: '{name} Casinò in breve', operator: 'Operatore', licence: 'Licenza', age: 'Età minima', src: 'Fonte: termini ufficiali del casinò, letti il {date}.', games: 'Slot del nostro catalogo presenti su {name}'},
};
---
<Base lang={lang} title={x.seoTitle} desc={x.seoDesc} path={path} jsonld={jsonld} active={c.id} noindex={NOINDEX.includes(c.id)}>
  <div class="page">
    <ol class="crumbs"><li><a href={href(lang)}>{r.crumbsHome}</a></li><li><a href={href(lang) + '#offers'}>{r.crumbsReviews}</a></li><li aria-current="page">{c.name}</li></ol>

    <header class={`rhero t-${c.id}`} data-mark={c.name.toUpperCase()} data-sticky-anchor>
      <div class="rhero-txt">
        <div class="rhero-id"><img src={c.logo} alt={`${c.name} logo`} width="64" height="64" /><span class="pill">{u.badge[c.badge]}</span></div>
        <h1>{x.h1}</h1>
        <p>{x.intro}</p>
        <ul class="stats rv-stats">{c.stats.map(s => <li><Icon name={ICON[s.k]} /><b>{s.v}</b><span>{u.stat[s.k]}</span></li>)}</ul>
      </div>
      <aside class="rhero-box">
        <span class="lbl">{d.list.bonusLabel}</span>
        <p class="big">{x.headline}</p>
        <p class="sub">{x.short}</p>
        {c.code && <div class="code"><span class="code-l">{u.code}</span><b>{c.code}</b><button type="button" data-copy={c.code} data-done={d.featured.copied} data-place="review"><Icon name="copy" /><span>{d.featured.copy}</span></button></div>}
        <a class="btn btn-play btn-block" href={c.affiliate} target="_blank" rel="sponsored noopener" data-go={c.id} data-place="review-hero"><Icon name="play" />{u.play}</a>
        <p class="fine">{c.code ? `${u.code}: ${c.code}` : u.noCode} · {d.footer.age}</p>
      </aside>
    </header>

    {c.facts && (
      <section class="sec facts">
        <h2>{FL[lang].h.replace('{name}', c.name)}</h2>
        <dl class="kv spec">
          <div><dt>{FL[lang].operator}</dt><dd>{c.facts.operator}</dd></div>
          <div><dt>{FL[lang].licence}</dt><dd>{c.facts.licence}</dd></div>
          <div><dt>{FL[lang].age}</dt><dd>18+</dd></div>
        </dl>
        <p class="note">{FL[lang].src.replace('{date}', fmtDate(lang, c.facts.checked))} <a href={c.facts.source} target="_blank" rel="noopener nofollow">{new URL(c.facts.source).hostname}</a></p>
      </section>
    )}

    <p class="byline"><img src="/img/bwd-256.png" alt="" width="30" height="30" /><span>{r.author}<small>{fmt(r.updated, {date})}</small></span></p>

    <h2 class="sec-title">{r.offer}</h2>
    <div class="pcards">
      {x.sections.map((s, i) => <section class={`pcard tone-${TONES[i]}`}><span class="pcard-ic"><Icon name={['gift', 'star', 'shield'][i] ?? 'check'} /></span><h3>{s.h}</h3><p>{s.p}</p></section>)}
    </div>

    <h2 class="sec-title">{r.how}</h2>
    <div class="steps">
      {x.howto.map((h, i) => <div class="step"><span class="n">{i + 1}</span><p>{h}</p></div>)}
    </div>
    <div class="cta-row"><a class="btn btn-play btn-lg" href={c.affiliate} target="_blank" rel="sponsored noopener" data-go={c.id} data-place="review-howto"><Icon name="play" />{u.play}</a>{c.code && <button class="codechip" type="button" data-copy={c.code} data-done={d.featured.copied} data-place="review-howto"><Icon name="copy" /><span>{u.code}: {c.code}</span></button>}</div>

    <h2 class="sec-title">{r.terms}</h2>
    <div class="terms-card">
      <dl class="kv">{x.terms.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <p class="fine">{fmt(r.checked, {date})}{c.terms.length > 0 && <> · {r.official} : {c.terms.map((l, i) => <>{i > 0 && ' · '}<a href={l.url} target="_blank" rel="nofollow noopener">{l.label}</a></>)}</>}</p>
    </div>

    <h2 class="sec-title">{r.deeper}</h2>
    <div class="pcards">
      {x.more.map((s, i) => <section class={`pcard tone-${TONES[(i + 2) % TONES.length]}`}><span class="pcard-ic"><Icon name={['check', 'clock', 'trophy', 'users'][i] ?? 'check'} /></span><h3>{s.h}</h3><p>{s.p}</p></section>)}
    </div>

    {SLOTS.some(g => g.at?.[c.id as 'rainbet']) && (
      <section class="sec">
        <h2>{FL[lang].games.replace('{name}', c.name)}</h2>
        <ul class="links">{SLOTS.filter(g => g.at?.[c.id as 'rainbet']).sort((a, b) => b.maxWin - a.maxWin).map(g => <li><a href={href(lang, `slots/${g.id}/`)}>{g.name}</a><span>{g.provider} · {SL[lang].maxWin} {g.maxWin.toLocaleString(d.locale)}x</span></li>)}</ul>
      </section>
    )}
    {c.providers.length > 0 && <div class="provs-card"><span>{r.providers}</span><div class="provs">{c.providers.map(p => <span>{p}</span>)}</div></div>}

    <div class="pc">
      <div class="pro"><h3><Icon name="check" />{r.pros}</h3><ul>{x.pros.map(p => <li><Icon name="check" />{p}</li>)}</ul></div>
      <div class="con"><h3><Icon name="alert" />{r.cons}</h3><ul>{x.cons.map(p => <li><Icon name="alert" />{p}</li>)}</ul></div>
    </div>

    {intentsOf(c.id, lang).length > 0 && <ul class="links">{intentsOf(c.id, lang).map(o => <li><a href={href(lang, intentPath(o))}>{o.h1}</a></li>)}</ul>}

    <h2 class="sec-title">{r.faq}</h2>
    <div class="faq">{faq.map(f => <details><summary>{f.q}<Icon name="plus" /></summary><p class="a">{f.a}</p></details>)}</div>

    <h2 class="sec-title">{r.compare}</h2>
    <div class="others">
      {pairs.map(([a, b]) => {
        const o = CASINOS.find(z => z.id === (a === c.id ? b : a))!;
        return <a class={`mini m-${o.id}`} href={href(lang, `vs/${a}-vs-${b}/`)}><img src={o.logo} alt="" width="44" height="44" loading="lazy" /><div><b>{c.name} vs {o.name}</b><span>{d.vs.table}</span></div><Icon name="arrow" /></a>;
      })}
      {CASINOS.filter(o => o.id !== c.id).map(o => <a class={`mini m-${o.id}`} href={href(lang, `casinos/${o.id}/`)}><img src={o.logo} alt="" width="44" height="44" loading="lazy" /><div><b>{o.name}</b><span>{d.casino[o.id].headline}</span></div><Icon name="arrow" /></a>)}
    </div>

    <div class="rg" style="margin-top:40px">
      <span class="ic">18+</span>
      <div><h3>{d.rg.title}</h3><p>{d.rg.p}</p></div>
      <a href={href(lang, 'responsible-gambling/')}>{d.rg.link} →</a>
    </div>
  </div>
</Base>
