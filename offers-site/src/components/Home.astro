---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import OfferCard from './OfferCard.astro';
import {t, href, fmt, fmtDate, type Lang} from '../i18n';
import {ui} from '../i18n/ui';
import {ranked, PAIRS, byId, CHECKED, YOUTUBE, TELEGRAM} from '../data/casinos';
import {winsPages, top, multi, money, streamerName, platformName, dayLabel} from '../data/wins';
interface Props {lang: Lang}
const {lang} = Astro.props;
const d = t(lang);
const u = ui(lang);
const CASINOS = ranked(lang);
// Le n°1 de la langue (Celsius en allemand, Rainbet ailleurs) est mis en vedette.
const lead = CASINOS[0];
const latest = (await winsPages())[0]?.v;
const hasWins = !!latest;
const no1 = latest ? top(latest)[0] : undefined;
const w = u.wins;
const date = fmtDate(lang, CHECKED);
const site = Astro.site!.origin;
const jsonld = [
  {'@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: d.locale, mainEntity: d.faq.items.map(f => ({'@type': 'Question', name: f.q, acceptedAnswer: {'@type': 'Answer', text: f.a}}))},
  {'@context': 'https://schema.org', '@type': 'ItemList', name: u.offersTitle, itemListElement: CASINOS.map(c => ({'@type': 'ListItem', position: c.rank, name: `${c.name} – ${d.casino[c.id].headline}`, url: site + href(lang, `casinos/${c.id}/`)}))},
];
---
<Base lang={lang} title={d.meta.homeTitle} desc={d.meta.homeDesc} jsonld={jsonld} active="home">
  <section class="home-hd">
    <div>
      <p class="kick">{fmt(d.hero.kicker, {date})}</p>
      <h1>{u.heroA} {u.heroB}</h1>
      <p class="lede">{u.heroSub}</p>
      <p class="home-jump"><a class="btn btn-lg btn-ghost" href="#offers">{u.offersTitle} ↓</a>{hasWins && <a class="btn btn-lg btn-ghost" href={href(lang, 'wins/')}>{w.latest} →</a>}</p>
    </div>
    {no1 && (
      <a class="score" href={href(lang, 'wins/')}>
        {/* Sur téléphone la vignette n’est ni affichée ni téléchargée : l’offre reste près du haut. */}
        {latest!.thumb && <div class="score-img"><picture><source media="(max-width: 700px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACw=" /><img src={latest!.thumb} alt="" width="480" height="270" fetchpriority="high" /></picture></div>}
        <div class="score-body">
          <span class="score-tag">#1 · {dayLabel(lang, latest!.period)}</span>
          <span class="score-x">{multi(no1.multi)}</span>
          <span class="score-who"><b>{streamerName(no1.streamer)}</b><span>{[no1.game, platformName(no1.platform)].filter(Boolean).join(' · ')}</span></span>
        </div>
      </a>
    )}
  </section>

  <section class="home-offer" aria-label={u.top}>
    <aside class="offer">
      <div class="offer-hd">
        <img src={lead.logo} alt="" width="44" height="44" />
        <div><b>{lead.name}</b><span>{u.top}</span></div>
      </div>
      <p class="offer-big">{d.casino[lead.id].headline}</p>
      {lead.code && <button class="codechip" type="button" data-copy={lead.code} data-done={d.featured.copied} data-place="hero"><span>{u.code}: {lead.code}</span><Icon name="copy" /></button>}
      <a class="btn btn-play btn-block" href={lead.affiliate} target="_blank" rel="sponsored noopener" data-go={lead.id} data-place="hero">{u.play}</a>
      <p class="small">18+ · <a href={href(lang, `casinos/${lead.id}/`)}>{u.review}</a></p>
    </aside>
  </section>

  <section class="sec" id="offers">
    <div class="sec-h"><h2>{u.offersTitle}</h2><span class="count">{fmt(u.offersCount, {n: CASINOS.length})}</span></div>
    <div class="cards">{CASINOS.map(c => <OfferCard lang={lang} c={c} />)}</div>
  </section>

  {latest && (
    <section class="sec">
      <div class="sec-h"><h2>{u.winsTitle}</h2><a href={href(lang, 'wins/')}>{w.latest} →</a></div>
      <table class="rk">
        <caption class="vh">{dayLabel(lang, latest.period)}</caption>
        <thead><tr><th scope="col">{w.cols[0]}</th><th scope="col">{w.cols[1]}</th><th scope="col">{w.cols[2]}</th><th scope="col" class="num">{w.cols[4]}</th><th scope="col" class="num">{w.cols[5]}</th></tr></thead>
        <tbody>{top(latest).slice(0, 5).map(c => <tr class={c.rank === 1 ? 'top' : undefined}><td class="pos">{c.rank}</td><td>{streamerName(c.streamer)}<span class="sub">{platformName(c.platform)}</span></td><td>{c.game ?? <span class="na">–</span>}</td><td class="num x">{multi(c.multi)}</td><td class="num">{money(c.bet, c.currency, lang)}</td></tr>)}</tbody>
      </table>
      <p class="note">{dayLabel(lang, latest.period)} · <a href={YOUTUBE} target="_blank" rel="noopener" data-go="youtube" data-place="home-wins">YouTube</a> · <a href={TELEGRAM} target="_blank" rel="noopener" data-go="telegram" data-place="home-wins">Telegram</a></p>
    </section>
  )}
  {!latest && (
    <section class="sec">
      <a class="tg" href={TELEGRAM} target="_blank" rel="noopener" data-go="telegram" data-place="wins"><b>{u.tg.title}</b><span>{u.tg.join} →</span></a>
    </section>
  )}

  <section class="sec">
    <div class="sec-h"><h2>{d.vs.crumbs}</h2></div>
    <ul class="links">{PAIRS.map(([a, b]) => <li><a href={href(lang, `vs/${a}-vs-${b}/`)}>{byId(a).name} vs {byId(b).name}</a><span>{d.vs.table}</span></li>)}</ul>
  </section>

  <section class="sec">
    <div class="sec-h"><h2>{d.steps.title}</h2></div>
    <ol class="steps">{d.steps.items.map(s => <li class="step"><h3>{s.t}</h3><p>{s.d}</p></li>)}</ol>
  </section>

  <section class="sec">
    <div class="sec-h"><h2>{d.who.title}</h2></div>
    <div class="who">
      <div><p>{d.who.p1}</p><p>{d.who.p2}</p></div>
      <ul>{d.who.promises.map(p => <li>{p}</li>)}</ul>
    </div>
  </section>

  <section class="sec">
    <div class="sec-h"><h2>{d.faq.title}</h2></div>
    <div class="faq">{d.faq.items.map(f => <details><summary>{f.q}<Icon name="plus" /></summary><p class="a">{f.a}</p></details>)}</div>
  </section>

  <section class="sec rg">
    <h2>{d.rg.title}</h2>
    <p>{d.rg.p} <a href={href(lang, 'responsible-gambling/')}>{d.rg.link}</a></p>
  </section>
</Base>
