---
// Logo Big Win Daily : pièce d'or « BW » + wordmark italique. Sert en header et en footer.
interface Props {size?: number; light?: boolean}
const {size = 40, light = false} = Astro.props;
const id = 'lg' + Math.random().toString(36).slice(2, 7);
---
<span class="logo-mark" style={`--s:${size}px`}>
  <svg viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
    <defs>
      <radialGradient id={`${id}a`} cx="35%" cy="30%" r="75%"><stop offset="0" stop-color="#fff4b8"/><stop offset=".45" stop-color="#ffcc33"/><stop offset="1" stop-color="#d98a00"/></radialGradient>
      <linearGradient id={`${id}b`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b86f00"/><stop offset="1" stop-color="#7a4600"/></linearGradient>
    </defs>
    <ellipse cx="32" cy="36" rx="28" ry="26" fill={`url(#${id}b)`}/>
    <circle cx="32" cy="31" r="28" fill={`url(#${id}a)`}/>
    <circle cx="32" cy="31" r="21.5" fill="none" stroke="#b87400" stroke-width="2.4" stroke-dasharray="3 3.2" opacity=".75"/>
    <path d="M36.5 13 21 34.5h10.2L27 49l16.5-22.6H33.2z" fill="#7a3d00"/>
    <path d="M35.5 12 20 33.5h10.2L26 48l16.5-22.6H32.2z" fill="#fff8d6"/>
  </svg>
  <span class={`logo-word ${light ? 'light' : ''}`}><b>BIG<i>WIN</i></b><small>DAILY</small></span>
</span>
