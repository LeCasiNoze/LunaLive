# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/lunalive

# API LunaLive (pour l'envoi de messages)
BOT_API_BASE=https://lunalive-api.onrender.com
BOT_INTERNAL_KEY=your-secret-key-here

# Identité du bot
BOT_USER_ID=123456789
BOT_USERNAME=LunaBot

# Configuration du registre
BOT_REGISTRY_POLL_MS=5000
BOT_CHAT_POLL_MS=800
BOT_CHAT_BATCH=200
BOT_CHAT_START_FROM_NOW=true
BOT_DEFAULT_PREFIX=!
BOT_LIVE_ONLY_DEFAULT=true

# Optionnel: forcer un streamer spécifique (dev)
# BOT_FORCE_STREAMER_SLUG=fabiozsis

# DLive (optionnel)
# DLIVE_BOT_AUTH=your-jwt-token
# DLIVE_GRAPHQL_ENDPOINT=https://graphigo.prd.dlive.tv/

# Health server (optionnel)
# PORT=3000

# ✅ YouTube Notifications (valeurs hardcodées, plus besoin de config sur Render)
# Seul YOUTUBE_POLL_INTERVAL_MS est optionnel pour override la fréquence par défaut (3 minutes)
# YOUTUBE_POLL_INTERVAL_MS=180000
