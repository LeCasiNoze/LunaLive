[Unit]
Description=AutoMod and Auto Hunt Discord announcements
After=network-online.target automod-web.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/automod/scripts/automod_discord_news.py
Restart=on-failure
RestartSec=10
StateDirectory=automod-discord-news
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/automod-discord-news
MemoryMax=64M
CPUQuota=5%

[Install]
WantedBy=multi-user.target
